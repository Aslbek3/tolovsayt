<!doctype html>
<html lang="uz">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> — <%= settings.site_name %></title>
  <%# Ichiga joylashtirilgan ikonka — brauzer /favicon.ico so'rab 404 olmasligi uchun %>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%233758f9'/%3E%3Crect x='6' y='10' width='20' height='13' rx='2.5' fill='%23fff'/%3E%3Crect x='6' y='13.5' width='20' height='3' fill='%233758f9'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<%
  // `path` ikki xil ko'rinishda kelishi mumkin: app.js dagi umumiy middleware to'liq
  // yo'lni qo'yadi ('/admin/clients'), admin router esa mount prefiksisiz ('/clients').
  // Shuning uchun ikkalasini bitta '/admin/...' shakliga keltiramiz.
  const ap = ('/admin' + path).replace(/^\/admin\/admin(\/|$)/, '/admin$1').replace(/\/+$/, '') || '/admin';
  // Admin qobig'i (sidebar + mobil tortma menyu) faqat login sahifasidan tashqari ko'rsatiladi
  const isAdminShell = typeof admin !== 'undefined' && admin && ap !== '/admin/login';
  const admNav = [
    { href: '/admin', ic: '📊', label: 'Panel', on: ap === '/admin' },
    { href: '/admin/clients', ic: '👥', label: 'Mijozlar', on: ap.startsWith('/admin/clients') },
    { href: '/admin/services', ic: '🧩', label: 'Xizmatlar', on: ap.startsWith('/admin/services') },
    { href: '/admin/payments', ic: '🧾', label: "To'lovlar", on: ap.startsWith('/admin/payments') },
    { href: '/admin/topups', ic: '💰', label: "Pul qo'shish", on: ap.startsWith('/admin/topups') },
    { href: '/admin/settings', ic: '⚙️', label: 'Sozlamalar', on: ap.startsWith('/admin/settings') },
  ];
  const admCur = admNav.find(n => n.on);
%>
<% if (isAdminShell) { %>
  <header class="adm-topbar">
    <button type="button" class="adm-burger" id="admBurger" aria-label="Menyu" aria-expanded="false" aria-controls="admSidebar">☰</button>
    <span class="adm-topbar-title"><%= admCur ? admCur.label : settings.site_name %></span>
  </header>
  <div class="adm-overlay" id="admOverlay"></div>
  <aside class="adm-sidebar" id="admSidebar">
    <a class="brand" href="/admin"><span class="logo">₿</span> <%= settings.site_name %> <small>admin</small></a>
    <nav class="adm-nav">
      <% admNav.forEach(n => { %><a href="<%= n.href %>" class="<%= n.on ? 'on' : '' %>"><span class="ic"><%= n.ic %></span><%= n.label %></a><% }) %>
      <form method="post" action="/admin/logout" class="adm-logout"><button class="link" type="submit"><span class="ic">⎋</span>Chiqish</button></form>
    </nav>
  </aside>
  <script src="/static/admin.js" defer></script>
<% } %>
<main class="wrap<%= isAdminShell ? ' adm-main' : '' %>">
<% if (flash) { %><div class="alert <%= flash.type %>"><%= flash.msg %></div><% } %>
