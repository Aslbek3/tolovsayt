<%- include('../partials/header') %>
<div class="row between">
  <h1>Boshqaruv paneli</h1>
  <form method="post" action="/admin/run-check"><button class="btn sm ghost" title="Eslatmalarni yuborish va muddati o'tganlarni to'xtatish">⟳ Hozir tekshirish</button></form>
</div>

<% if (!botUsername) { %>
  <div class="alert error">Telegram bot ulanmagan. <code>.env</code> faylida BOT_TOKEN va ADMIN_CHAT_ID ni to'ldiring.</div>
<% } %>

<div class="stats">
  <div class="stat"><span>Oylik daromad (faol)</span><b><%= u.money(stats.monthly) %></b></div>
  <div class="stat"><span>Shu oy tushgan</span><b><%= u.money(stats.thisMonth) %></b></div>
  <div class="stat"><span>Mijozlar</span><b><%= stats.clients %></b></div>
  <div class="stat"><span>Faol / to'xtatilgan</span><b><%= stats.active %> / <span style="color:var(--red)"><%= stats.suspended %></span></b></div>
  <div class="stat"><span>Kutilayotgan to'lovlar</span><b style="color:var(--amber)"><%= stats.pending %></b></div>
  <div class="stat"><span>Mijozlar balansi (jami)</span><b><%= u.money(stats.totalBalance) %></b></div>
</div>

<div class="card table-wrap">
  <h2>⏳ Tasdiqlash kutilayotgan to'lovlar</h2>
  <% if (!pendingPayments.length) { %><p class="muted">Yangi to'lovlar yo'q.</p><% } else { %>
  <table>
    <tr><th>#</th><th>Mijoz</th><th>Xizmat</th><th>Summa</th><th>Chek</th><th></th></tr>
    <% pendingPayments.forEach(p => { %><%- include('_payrow', { p }) %><% }) %>
  </table>
  <% } %>
</div>

<div class="card table-wrap">
  <h2>💰 Tasdiqlash kutilayotgan "hisobga pul qo'shish" so'rovlari</h2>
  <% if (!pendingTopups.length) { %><p class="muted">Yangi so'rov yo'q.</p><% } else { %>
  <table>
    <tr><th>#</th><th>Mijoz</th><th>Summa</th><th>Chek</th><th></th></tr>
    <% pendingTopups.forEach(t => { %><%- include('_topuprow', { t }) %><% }) %>
  </table>
  <% } %>
</div>

<div class="card table-wrap">
  <h2>📅 Muddati yaqin va o'tgan xizmatlar (7 kun)</h2>
  <% if (!due.length) { %><p class="muted">Hammasi joyida.</p><% } else { %>
  <table>
    <tr><th>Xizmat</th><th>Mijoz</th><th>Narx</th><th>Muddat</th><th>Holat</th></tr>
    <% due.forEach(s => { %>
    <tr>
      <td><a href="/admin/services/<%= s.id %>"><%= s.name %></a></td>
      <td><a href="/admin/clients/<%= s.client_id %>"><%= s.client_name %></a></td>
      <td><%= u.money(s.price) %></td>
      <td><%= u.fmtDate(s.paid_until) %></td>
      <td><%- include('../partials/badge', { s }) %></td>
    </tr>
    <% }) %>
  </table>
  <% } %>
</div>
<%- include('../partials/footer') %>
