<%- include('../partials/header') %>
<h1>Hisobim</h1>

<div class="card row between">
  <div>
    <span class="muted small">Balans</span>
    <div class="price" style="margin-top:2px"><%= u.money(summary.balance) %></div>
  </div>
  <a class="btn" href="/topup">+ Hisobni to'ldirish</a>
</div>

<div class="cols">
  <div class="card">
    <h2>Ma'lumotlar</h2>
    <p><span class="muted">Ism:</span> <b><%= summary.client.name %></b></p>
    <p><span class="muted">Telefon:</span> <b>+<%= summary.client.phone %></b></p>
    <p><span class="muted">A'zo bo'lgan sana:</span> <b><%= u.fmtDate(summary.client.created_at) %></b></p>
    <p><span class="muted">Telegram:</span> <%- summary.client.tg_chat_id ? '<span class="badge green">Ulangan</span>' : '<span class="badge gray">Ulanmagan</span>' %></p>
  </div>
  <div class="card">
    <h2>Statistika</h2>
    <p><span class="muted">Jami xizmatlar:</span> <b><%= summary.totalServices %></b></p>
    <p><span class="muted">Faol:</span> <b><%= summary.activeCount %></b> &nbsp; <span class="muted">To'xtatilgan:</span> <b><%= summary.suspendedCount %></b></p>
    <p><span class="muted">Jami to'langan:</span> <b><%= u.money(summary.totalPaid) %></b></p>
    <% if (summary.lastPaymentDate) { %><p><span class="muted">Oxirgi to'lov:</span> <b><%= u.fmtDate(summary.lastPaymentDate) %></b></p><% } %>
    <% if (summary.nearestDue) { %><p><span class="muted">Eng yaqin to'lov muddati:</span> <b><%= u.fmtDate(summary.nearestDue) %></b></p><% } %>
  </div>
</div>

<div class="card table-wrap">
  <h2>Hisobni to'ldirish tarixi</h2>
  <% if (!summary.topups.length) { %><p class="muted">Hali so'rov yo'q.</p><% } else { %>
  <table>
    <tr><th>Sana</th><th>Summa</th><th>Holat</th></tr>
    <% summary.topups.forEach(t => { %>
    <tr>
      <td><%= u.fmtDate(t.created_at) %></td>
      <td><%= u.money(t.amount) %></td>
      <td>
        <% if (t.status === 'pending') { %><span class="badge amber">Tekshirilmoqda</span>
        <% } else if (t.status === 'approved') { %><span class="badge green">Tasdiqlandi</span>
        <% } else { %><span class="badge red">Rad etildi</span><% } %>
        <% if (t.status === 'rejected' && t.admin_note) { %><div class="muted small"><%= t.admin_note %></div><% } %>
      </td>
    </tr>
    <% }) %>
  </table>
  <% } %>
</div>
<%- include('../partials/footer') %>
