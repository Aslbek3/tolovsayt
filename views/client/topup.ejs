<%# `flow` include'ga data orqali uzatiladi — shablondagi `const` o'tmaydi %>
<%- include('../partials/chead', { flow: true }) %>

<div class="flow-head">
  <a class="back" href="/" aria-label="Orqaga">←</a>
  <h1>Hisobni to'ldirish</h1>
</div>

<div class="c-notice info">
  <span class="ic">💡</span>
  <div class="bd">
    Qo'shgan summangiz admin tasdiqlagach balansga tushadi. Keyin xizmatlarga
    <b style="display:inline">chek yuklamasdan</b>, bir bosishda to'lashingiz mumkin.
  </div>
</div>

<form class="card" method="post" action="/topup" enctype="multipart/form-data" data-once="Yuborilmoqda…">

  <label for="amount">Qancha pul qo'shasiz?</label>
  <input id="amount" name="amount" type="text" inputmode="numeric" autocomplete="off"
         placeholder="100 000" data-amount required>

  <div class="chips c3" style="margin-top:9px">
    <% [50000, 100000, 200000].forEach(v => { %>
      <button type="button" class="amt-chip" data-fill="<%= v %>" data-fill-target="#amount"><%= u.money(v).replace(" so'm", '') %></button>
    <% }) %>
  </div>

  <div class="sum-card">
    <div class="lbl">Shu kartaga o'tkazing</div>
    <%- include('../partials/bankcard') %>
  </div>

  <label>Chek rasmi</label>
  <div class="file-pick">
    <label class="zone">
      <input type="file" name="receipt" accept="image/*,.pdf" required>
      <span class="em">🧾</span>
      <b>Chek skrinshotini tanlang</b>
      <span class="hint">JPG, PNG yoki PDF · 8 MB gacha</span>
    </label>
    <div class="file-prev">
      <img alt="chek">
      <div class="pdf" style="display:none">📄</div>
      <div class="meta"><b></b><span></span></div>
      <button type="button" class="rm" aria-label="O'chirish">✕</button>
    </div>
  </div>

  <label>Izoh <span class="muted" style="font-weight:400">(ixtiyoriy)</span></label>
  <input name="comment" placeholder="Masalan: Payme orqali to'ladim">

  <button class="btn full" type="submit">Chekni yuborish</button>
</form>

<%- include('../partials/cfoot') %>
